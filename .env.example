# 환경 설정
ENV=dev
TZ=Asia/Seoul
TRADING_ENV=virtual
LOG_LEVEL=INFO

# AWS SES / S3
AWS_REGION=ap-northeast-2
AWS_SES_SENDER=
S3_BUCKET=your-portfolio-bucket

# Brokers (KIS)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NUMBER=1234567801
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Brokers (Other)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# Kakao (선택)
KAKAO_CHANNEL_ID=
KAKAO_API_KEY=

# OpenAI/Anthropic (선택)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

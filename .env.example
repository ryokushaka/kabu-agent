# ===========================================
# Kabu Agent Environment Variables
# ===========================================
# Copy this file to .env and fill in values

# ===========================================
# Database (Supabase PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ===========================================
# Redis Cache (Upstash)
# ===========================================
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# ===========================================
# KIS API (한국투자증권)
# ===========================================
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NUMBER=12345678-01
KIS_IS_LIVE=false
TRADING_ENV=vps

# ===========================================
# AI (Google Gemini)
# ===========================================
GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# Auth
# ===========================================
JWT_SECRET_KEY=your_jwt_secret_key_change_this

# ===========================================
# CORS (Production)
# ===========================================
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ===========================================
# Batch Jobs
# ===========================================
ENABLE_BATCH_JOBS=true
NEWS_COLLECTION_INTERVAL_HOURS=2
PORTFOLIO_SNAPSHOT_HOUR=16
MARKET_INDICES_INTERVAL_HOURS=4

# ===========================================
# Frontend (Vite)
# ===========================================
# Leave empty for relative paths (recommended for Docker/nginx proxy)
# Or set to http://localhost:8000 for local development without Docker
VITE_API_BASE_URL=

# ===========================================
# Environment
# ===========================================
ENVIRONMENT=development
DEBUG=false

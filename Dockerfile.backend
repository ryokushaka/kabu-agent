# Python 3.11 이미지 사용
FROM python:3.11-slim

# 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 업데이트 및 필요한 패키지 설치
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python 의존성 파일 복사
COPY requirements.txt .

# Python 의존성 설치
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 추가 의존성 설치 (PostgreSQL, Redis)
RUN pip install --no-cache-dir \
    psycopg2-binary==2.9.9 \
    redis==5.0.1 \
    alembic==1.13.1 \
    sqlalchemy==2.0.23

# 애플리케이션 코드 복사
COPY . .

# 로그 및 데이터 디렉토리 생성
RUN mkdir -p /app/logs /app/data

# 환경변수 설정
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 포트 노출
EXPOSE 8000

# 헬스체크 스크립트 생성
RUN echo '#!/bin/bash\ncurl -f http://localhost:8000/health || exit 1' > /app/healthcheck.sh && \
    chmod +x /app/healthcheck.sh

# 시작 스크립트 생성
RUN echo '#!/bin/bash\n\
# 데이터베이스 연결 대기\n\
echo "Waiting for PostgreSQL..."\n\
host="${POSTGRES_HOST:-postgres}"\n\
user="${POSTGRES_USER:-kabu_user}"\n\
until pg_isready -h "$host" -p 5432 -U "$user"; do\n\
  echo "Waiting for PostgreSQL at $host..."\n\
  sleep 2\n\
done\n\
echo "PostgreSQL is ready!"\n\
\n\
# 데이터베이스 마이그레이션 (있는 경우)\n\
echo "Running database migrations..."\n\
# alembic upgrade head 2>/dev/null || echo "No migrations to run"\n\
\n\
# FastAPI 서버 시작\n\
echo "Starting FastAPI server..."\n\
uvicorn src.app:app --host 0.0.0.0 --port 8000 --workers 1\n\
' > /app/start.sh && chmod +x /app/start.sh

# 시작 명령
CMD ["/app/start.sh"]
# =============================================================================
# Kabu Agent Kubernetes Configuration - Default Values
# =============================================================================
# Centralized configuration for all K8s deployments
#
# Usage:
#   1. Copy to config/values.env for customization
#   2. Source in deploy scripts: source "${SCRIPT_DIR}/../config/values.env"
#   3. Override via environment variables at deploy time
#
# Environment-specific overrides:
#   - config/values-dev.env
#   - config/values-staging.env
#   - config/values-prod.env
# -----------------------------------------------------------------------------

# =============================================================================
# Domain & Networking
# =============================================================================
DOMAIN_NAME="${DOMAIN_NAME:-localhost}"
CLUSTER_NAME="${CLUSTER_NAME:-kabu-cluster}"
APP_NAMESPACE="${APP_NAMESPACE:-kabu-agent}"

# =============================================================================
# Resource Profiles
# =============================================================================
# Profile: minimal (4GB RAM), standard (8GB RAM), production (16GB+ RAM)
RESOURCE_PROFILE="${RESOURCE_PROFILE:-minimal}"

# -----------------------------------------------------------------------------
# Minimal Profile (4GB RAM total)
# -----------------------------------------------------------------------------
# Prometheus
PROMETHEUS_CPU_REQUEST="${PROMETHEUS_CPU_REQUEST:-100m}"
PROMETHEUS_CPU_LIMIT="${PROMETHEUS_CPU_LIMIT:-500m}"
PROMETHEUS_MEMORY_REQUEST="${PROMETHEUS_MEMORY_REQUEST:-256Mi}"
PROMETHEUS_MEMORY_LIMIT="${PROMETHEUS_MEMORY_LIMIT:-384Mi}"
PROMETHEUS_RETENTION="${PROMETHEUS_RETENTION:-3d}"
PROMETHEUS_STORAGE_SIZE="${PROMETHEUS_STORAGE_SIZE:-5Gi}"

# Grafana
GRAFANA_CPU_REQUEST="${GRAFANA_CPU_REQUEST:-50m}"
GRAFANA_CPU_LIMIT="${GRAFANA_CPU_LIMIT:-200m}"
GRAFANA_MEMORY_REQUEST="${GRAFANA_MEMORY_REQUEST:-64Mi}"
GRAFANA_MEMORY_LIMIT="${GRAFANA_MEMORY_LIMIT:-128Mi}"
GRAFANA_STORAGE_SIZE="${GRAFANA_STORAGE_SIZE:-1Gi}"

# Alertmanager
ALERTMANAGER_CPU_REQUEST="${ALERTMANAGER_CPU_REQUEST:-10m}"
ALERTMANAGER_CPU_LIMIT="${ALERTMANAGER_CPU_LIMIT:-100m}"
ALERTMANAGER_MEMORY_REQUEST="${ALERTMANAGER_MEMORY_REQUEST:-32Mi}"
ALERTMANAGER_MEMORY_LIMIT="${ALERTMANAGER_MEMORY_LIMIT:-64Mi}"

# Jaeger
JAEGER_CPU_REQUEST="${JAEGER_CPU_REQUEST:-50m}"
JAEGER_CPU_LIMIT="${JAEGER_CPU_LIMIT:-500m}"
JAEGER_MEMORY_REQUEST="${JAEGER_MEMORY_REQUEST:-128Mi}"
JAEGER_MEMORY_LIMIT="${JAEGER_MEMORY_LIMIT:-256Mi}"
JAEGER_MAX_TRACES="${JAEGER_MAX_TRACES:-10000}"

# OpenTelemetry Collector
OTEL_COLLECTOR_CPU_REQUEST="${OTEL_COLLECTOR_CPU_REQUEST:-25m}"
OTEL_COLLECTOR_CPU_LIMIT="${OTEL_COLLECTOR_CPU_LIMIT:-200m}"
OTEL_COLLECTOR_MEMORY_REQUEST="${OTEL_COLLECTOR_MEMORY_REQUEST:-64Mi}"
OTEL_COLLECTOR_MEMORY_LIMIT="${OTEL_COLLECTOR_MEMORY_LIMIT:-128Mi}"

# Istiod
ISTIOD_CPU_REQUEST="${ISTIOD_CPU_REQUEST:-100m}"
ISTIOD_CPU_LIMIT="${ISTIOD_CPU_LIMIT:-500m}"
ISTIOD_MEMORY_REQUEST="${ISTIOD_MEMORY_REQUEST:-128Mi}"
ISTIOD_MEMORY_LIMIT="${ISTIOD_MEMORY_LIMIT:-256Mi}"

# Ztunnel (per node)
ZTUNNEL_CPU_REQUEST="${ZTUNNEL_CPU_REQUEST:-25m}"
ZTUNNEL_CPU_LIMIT="${ZTUNNEL_CPU_LIMIT:-200m}"
ZTUNNEL_MEMORY_REQUEST="${ZTUNNEL_MEMORY_REQUEST:-32Mi}"
ZTUNNEL_MEMORY_LIMIT="${ZTUNNEL_MEMORY_LIMIT:-64Mi}"

# Kiali
KIALI_CPU_REQUEST="${KIALI_CPU_REQUEST:-25m}"
KIALI_CPU_LIMIT="${KIALI_CPU_LIMIT:-200m}"
KIALI_MEMORY_REQUEST="${KIALI_MEMORY_REQUEST:-64Mi}"
KIALI_MEMORY_LIMIT="${KIALI_MEMORY_LIMIT:-128Mi}"

# Node Exporter
NODE_EXPORTER_CPU_REQUEST="${NODE_EXPORTER_CPU_REQUEST:-10m}"
NODE_EXPORTER_CPU_LIMIT="${NODE_EXPORTER_CPU_LIMIT:-100m}"
NODE_EXPORTER_MEMORY_REQUEST="${NODE_EXPORTER_MEMORY_REQUEST:-32Mi}"
NODE_EXPORTER_MEMORY_LIMIT="${NODE_EXPORTER_MEMORY_LIMIT:-64Mi}"

# Kube State Metrics
KSM_CPU_REQUEST="${KSM_CPU_REQUEST:-10m}"
KSM_CPU_LIMIT="${KSM_CPU_LIMIT:-100m}"
KSM_MEMORY_REQUEST="${KSM_MEMORY_REQUEST:-32Mi}"
KSM_MEMORY_LIMIT="${KSM_MEMORY_LIMIT:-64Mi}"

# =============================================================================
# Telemetry Configuration
# =============================================================================
OTEL_ENABLED="${OTEL_ENABLED:-false}"
OTEL_SERVICE_NAME="${OTEL_SERVICE_NAME:-kabu-backend}"
OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://otel-collector.monitoring.svc.cluster.local:4317}"
OTEL_TRACE_SAMPLE_RATE="${OTEL_TRACE_SAMPLE_RATE:-0.1}"
OTEL_DEBUG="${OTEL_DEBUG:-false}"

# TLS Configuration
OTEL_EXPORTER_OTLP_INSECURE="${OTEL_EXPORTER_OTLP_INSECURE:-true}"

# =============================================================================
# Istio Configuration
# =============================================================================
ISTIO_VERSION="${ISTIO_VERSION:-1.20.2}"
ISTIO_AMBIENT_MODE="${ISTIO_AMBIENT_MODE:-true}"
ISTIO_MTLS_MODE="${ISTIO_MTLS_MODE:-STRICT}"

# =============================================================================
# Alerting Configuration
# =============================================================================
SLACK_WEBHOOK_URL="${SLACK_WEBHOOK_URL:-}"
SLACK_CHANNEL="${SLACK_CHANNEL:-#alerts}"
ALERT_RECEIVER_EMAIL="${ALERT_RECEIVER_EMAIL:-}"

# =============================================================================
# Storage Configuration
# =============================================================================
STORAGE_CLASS="${STORAGE_CLASS:-local-path}"

# =============================================================================
# Image Tags (for version pinning)
# =============================================================================
PROMETHEUS_VERSION="${PROMETHEUS_VERSION:-v2.48.0}"
GRAFANA_VERSION="${GRAFANA_VERSION:-10.2.2}"
ALERTMANAGER_VERSION="${ALERTMANAGER_VERSION:-0.26.0}"
JAEGER_VERSION="${JAEGER_VERSION:-1.52}"
OTEL_COLLECTOR_VERSION="${OTEL_COLLECTOR_VERSION:-0.90.0}"
KIALI_VERSION="${KIALI_VERSION:-1.78}"

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_TRACING="${ENABLE_TRACING:-false}"
ENABLE_ISTIO="${ENABLE_ISTIO:-false}"
ENABLE_KIALI="${ENABLE_KIALI:-false}"
ENABLE_SLO_ALERTS="${ENABLE_SLO_ALERTS:-true}"

# =============================================================================
# Scrape Intervals
# =============================================================================
PROMETHEUS_SCRAPE_INTERVAL="${PROMETHEUS_SCRAPE_INTERVAL:-30s}"
PROMETHEUS_EVALUATION_INTERVAL="${PROMETHEUS_EVALUATION_INTERVAL:-30s}"

# =============================================================================
# Log Levels
# =============================================================================
GRAFANA_LOG_LEVEL="${GRAFANA_LOG_LEVEL:-warn}"
ISTIO_LOG_LEVEL="${ISTIO_LOG_LEVEL:-warning}"
OTEL_LOG_LEVEL="${OTEL_LOG_LEVEL:-info}"

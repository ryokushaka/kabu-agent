# =============================================================================
# Kabu Agent Kubernetes Configuration - Development Environment
# =============================================================================
# Override values for local/development deployments
#
# Usage:
#   source config/default-values.env
#   source config/values-dev.env
#
# Characteristics:
#   - Minimal resources (local Docker Desktop, Minikube, K3s)
#   - Debug logging enabled
#   - Short retention periods
#   - All tracing enabled for debugging
# -----------------------------------------------------------------------------

# =============================================================================
# Environment Identification
# =============================================================================
ENVIRONMENT="development"
RESOURCE_PROFILE="minimal"

# =============================================================================
# Domain & Networking
# =============================================================================
DOMAIN_NAME="localhost"
CLUSTER_NAME="kabu-dev"

# =============================================================================
# Resource Limits (Minimal - suitable for 4GB RAM)
# =============================================================================
# Prometheus (reduced for local)
PROMETHEUS_CPU_REQUEST="50m"
PROMETHEUS_CPU_LIMIT="300m"
PROMETHEUS_MEMORY_REQUEST="128Mi"
PROMETHEUS_MEMORY_LIMIT="256Mi"
PROMETHEUS_RETENTION="1d"
PROMETHEUS_STORAGE_SIZE="2Gi"

# Grafana
GRAFANA_CPU_REQUEST="25m"
GRAFANA_CPU_LIMIT="100m"
GRAFANA_MEMORY_REQUEST="32Mi"
GRAFANA_MEMORY_LIMIT="64Mi"
GRAFANA_STORAGE_SIZE="512Mi"

# Alertmanager
ALERTMANAGER_CPU_REQUEST="5m"
ALERTMANAGER_CPU_LIMIT="50m"
ALERTMANAGER_MEMORY_REQUEST="16Mi"
ALERTMANAGER_MEMORY_LIMIT="32Mi"

# Jaeger
JAEGER_CPU_REQUEST="25m"
JAEGER_CPU_LIMIT="200m"
JAEGER_MEMORY_REQUEST="64Mi"
JAEGER_MEMORY_LIMIT="128Mi"
JAEGER_MAX_TRACES="1000"

# OpenTelemetry Collector
OTEL_COLLECTOR_CPU_REQUEST="10m"
OTEL_COLLECTOR_CPU_LIMIT="100m"
OTEL_COLLECTOR_MEMORY_REQUEST="32Mi"
OTEL_COLLECTOR_MEMORY_LIMIT="64Mi"

# =============================================================================
# Telemetry Configuration
# =============================================================================
OTEL_ENABLED="true"
OTEL_TRACE_SAMPLE_RATE="1.0"  # 100% sampling in dev
OTEL_DEBUG="true"
OTEL_EXPORTER_OTLP_INSECURE="true"

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_TRACING="true"
ENABLE_ISTIO="false"  # Disable in dev to save resources
ENABLE_KIALI="false"
ENABLE_SLO_ALERTS="false"  # No SLO alerts in dev

# =============================================================================
# Scrape Intervals (more frequent for debugging)
# =============================================================================
PROMETHEUS_SCRAPE_INTERVAL="15s"
PROMETHEUS_EVALUATION_INTERVAL="15s"

# =============================================================================
# Log Levels (verbose for debugging)
# =============================================================================
GRAFANA_LOG_LEVEL="debug"
ISTIO_LOG_LEVEL="debug"
OTEL_LOG_LEVEL="debug"

# =============================================================================
# Alerting (disabled or test channel)
# =============================================================================
SLACK_CHANNEL="#kabu-dev-alerts"

# =============================================================================
# Storage
# =============================================================================
STORAGE_CLASS="local-path"

# =============================================================================
# Kabu Agent Kubernetes Configuration - Production Environment
# =============================================================================
# Override values for production deployments
#
# Usage:
#   source config/default-values.env
#   source config/values-prod.env
#
# Characteristics:
#   - High availability configuration
#   - Maximum resources (t4g.xlarge+, 16GB+ RAM)
#   - Full security hardening (mTLS STRICT)
#   - Conservative sampling to reduce overhead
#   - Long retention periods
#   - Critical alerting only
# -----------------------------------------------------------------------------

# =============================================================================
# Environment Identification
# =============================================================================
ENVIRONMENT="production"
RESOURCE_PROFILE="production"

# =============================================================================
# Domain & Networking
# =============================================================================
DOMAIN_NAME="kabu.example.com"
CLUSTER_NAME="kabu-prod"

# =============================================================================
# Resource Limits (Production - 16GB+ RAM cluster)
# =============================================================================
# Prometheus
PROMETHEUS_CPU_REQUEST="250m"
PROMETHEUS_CPU_LIMIT="1000m"
PROMETHEUS_MEMORY_REQUEST="512Mi"
PROMETHEUS_MEMORY_LIMIT="1Gi"
PROMETHEUS_RETENTION="15d"
PROMETHEUS_STORAGE_SIZE="50Gi"

# Grafana
GRAFANA_CPU_REQUEST="100m"
GRAFANA_CPU_LIMIT="500m"
GRAFANA_MEMORY_REQUEST="128Mi"
GRAFANA_MEMORY_LIMIT="256Mi"
GRAFANA_STORAGE_SIZE="5Gi"

# Alertmanager
ALERTMANAGER_CPU_REQUEST="25m"
ALERTMANAGER_CPU_LIMIT="200m"
ALERTMANAGER_MEMORY_REQUEST="64Mi"
ALERTMANAGER_MEMORY_LIMIT="128Mi"

# Jaeger
JAEGER_CPU_REQUEST="100m"
JAEGER_CPU_LIMIT="1000m"
JAEGER_MEMORY_REQUEST="256Mi"
JAEGER_MEMORY_LIMIT="512Mi"
JAEGER_MAX_TRACES="100000"

# OpenTelemetry Collector
OTEL_COLLECTOR_CPU_REQUEST="100m"
OTEL_COLLECTOR_CPU_LIMIT="500m"
OTEL_COLLECTOR_MEMORY_REQUEST="128Mi"
OTEL_COLLECTOR_MEMORY_LIMIT="256Mi"

# Istiod
ISTIOD_CPU_REQUEST="250m"
ISTIOD_CPU_LIMIT="1000m"
ISTIOD_MEMORY_REQUEST="256Mi"
ISTIOD_MEMORY_LIMIT="512Mi"

# Ztunnel
ZTUNNEL_CPU_REQUEST="100m"
ZTUNNEL_CPU_LIMIT="500m"
ZTUNNEL_MEMORY_REQUEST="64Mi"
ZTUNNEL_MEMORY_LIMIT="128Mi"

# Kiali
KIALI_CPU_REQUEST="100m"
KIALI_CPU_LIMIT="500m"
KIALI_MEMORY_REQUEST="128Mi"
KIALI_MEMORY_LIMIT="256Mi"

# Node Exporter
NODE_EXPORTER_CPU_REQUEST="25m"
NODE_EXPORTER_CPU_LIMIT="200m"
NODE_EXPORTER_MEMORY_REQUEST="48Mi"
NODE_EXPORTER_MEMORY_LIMIT="96Mi"

# Kube State Metrics
KSM_CPU_REQUEST="25m"
KSM_CPU_LIMIT="200m"
KSM_MEMORY_REQUEST="48Mi"
KSM_MEMORY_LIMIT="96Mi"

# =============================================================================
# Telemetry Configuration
# =============================================================================
OTEL_ENABLED="true"
OTEL_TRACE_SAMPLE_RATE="0.1"  # 10% sampling for production
OTEL_DEBUG="false"
OTEL_EXPORTER_OTLP_INSECURE="false"  # Use TLS in production

# =============================================================================
# Istio Configuration
# =============================================================================
ISTIO_AMBIENT_MODE="true"
ISTIO_MTLS_MODE="STRICT"  # Enforce mTLS in production

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_TRACING="true"
ENABLE_ISTIO="true"
ENABLE_KIALI="true"
ENABLE_SLO_ALERTS="true"

# =============================================================================
# Scrape Intervals (conservative for production)
# =============================================================================
PROMETHEUS_SCRAPE_INTERVAL="30s"
PROMETHEUS_EVALUATION_INTERVAL="30s"

# =============================================================================
# Log Levels (minimal logging in production)
# =============================================================================
GRAFANA_LOG_LEVEL="warn"
ISTIO_LOG_LEVEL="warning"
OTEL_LOG_LEVEL="warn"

# =============================================================================
# Alerting
# =============================================================================
SLACK_CHANNEL="#kabu-prod-alerts"

# =============================================================================
# Storage
# =============================================================================
STORAGE_CLASS="gp3"  # AWS EBS gp3 with high IOPS

# =============================================================================
# Kabu Agent Kubernetes Configuration - Staging Environment
# =============================================================================
# Override values for staging/QA deployments
#
# Usage:
#   source config/default-values.env
#   source config/values-staging.env
#
# Characteristics:
#   - Production-like configuration
#   - Moderate resources (t4g.large, 8GB RAM)
#   - Full observability stack enabled
#   - Reduced sampling rates
#   - Separate alert channels
# -----------------------------------------------------------------------------

# =============================================================================
# Environment Identification
# =============================================================================
ENVIRONMENT="staging"
RESOURCE_PROFILE="standard"

# =============================================================================
# Domain & Networking
# =============================================================================
DOMAIN_NAME="staging.kabu.example.com"
CLUSTER_NAME="kabu-staging"

# =============================================================================
# Resource Limits (Standard - 8GB RAM cluster)
# =============================================================================
# Prometheus
PROMETHEUS_CPU_REQUEST="150m"
PROMETHEUS_CPU_LIMIT="750m"
PROMETHEUS_MEMORY_REQUEST="384Mi"
PROMETHEUS_MEMORY_LIMIT="512Mi"
PROMETHEUS_RETENTION="7d"
PROMETHEUS_STORAGE_SIZE="10Gi"

# Grafana
GRAFANA_CPU_REQUEST="75m"
GRAFANA_CPU_LIMIT="300m"
GRAFANA_MEMORY_REQUEST="96Mi"
GRAFANA_MEMORY_LIMIT="192Mi"
GRAFANA_STORAGE_SIZE="2Gi"

# Alertmanager
ALERTMANAGER_CPU_REQUEST="15m"
ALERTMANAGER_CPU_LIMIT="150m"
ALERTMANAGER_MEMORY_REQUEST="48Mi"
ALERTMANAGER_MEMORY_LIMIT="96Mi"

# Jaeger
JAEGER_CPU_REQUEST="75m"
JAEGER_CPU_LIMIT="750m"
JAEGER_MEMORY_REQUEST="192Mi"
JAEGER_MEMORY_LIMIT="384Mi"
JAEGER_MAX_TRACES="50000"

# OpenTelemetry Collector
OTEL_COLLECTOR_CPU_REQUEST="50m"
OTEL_COLLECTOR_CPU_LIMIT="300m"
OTEL_COLLECTOR_MEMORY_REQUEST="96Mi"
OTEL_COLLECTOR_MEMORY_LIMIT="192Mi"

# Istiod
ISTIOD_CPU_REQUEST="150m"
ISTIOD_CPU_LIMIT="750m"
ISTIOD_MEMORY_REQUEST="192Mi"
ISTIOD_MEMORY_LIMIT="384Mi"

# Ztunnel
ZTUNNEL_CPU_REQUEST="50m"
ZTUNNEL_CPU_LIMIT="300m"
ZTUNNEL_MEMORY_REQUEST="48Mi"
ZTUNNEL_MEMORY_LIMIT="96Mi"

# Kiali
KIALI_CPU_REQUEST="50m"
KIALI_CPU_LIMIT="300m"
KIALI_MEMORY_REQUEST="96Mi"
KIALI_MEMORY_LIMIT="192Mi"

# =============================================================================
# Telemetry Configuration
# =============================================================================
OTEL_ENABLED="true"
OTEL_TRACE_SAMPLE_RATE="0.25"  # 25% sampling
OTEL_DEBUG="false"
OTEL_EXPORTER_OTLP_INSECURE="true"

# =============================================================================
# Istio Configuration
# =============================================================================
ISTIO_AMBIENT_MODE="true"
ISTIO_MTLS_MODE="PERMISSIVE"  # Allow non-mesh traffic during testing

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_TRACING="true"
ENABLE_ISTIO="true"
ENABLE_KIALI="true"
ENABLE_SLO_ALERTS="true"

# =============================================================================
# Scrape Intervals
# =============================================================================
PROMETHEUS_SCRAPE_INTERVAL="20s"
PROMETHEUS_EVALUATION_INTERVAL="20s"

# =============================================================================
# Log Levels
# =============================================================================
GRAFANA_LOG_LEVEL="info"
ISTIO_LOG_LEVEL="info"
OTEL_LOG_LEVEL="info"

# =============================================================================
# Alerting
# =============================================================================
SLACK_CHANNEL="#kabu-staging-alerts"

# =============================================================================
# Storage
# =============================================================================
STORAGE_CLASS="gp3"  # AWS EBS gp3
